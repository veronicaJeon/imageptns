{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imagepartners-image-runtime",
  "main": "cloudflare-image-worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  }
}
