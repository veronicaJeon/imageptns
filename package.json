{
  "name": "imageptns",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "npm run supabase:start && npm run dev",
    "supabase:start": "npx supabase start --workdir .",
    "supabase:stop": "npx supabase stop --workdir .",
    "supabase:status": "npx supabase status --workdir .",
    "supabase:reset": "npx supabase db reset --workdir .",
    "supabase:check": "node scripts/check-local-supabase.mjs",
    "eval:semantic:smoke": "node scripts/semantic-evaluation-smoke.mjs",
    "migrate:fingerprints:v2": "node --env-file-if-exists=.dev.vars --experimental-strip-types scripts/migrate-image-fingerprints-v2.mjs",
    "e2e:production:checkout": "node scripts/production-checkout-e2e.mjs --confirm-production",
    "build": "next build --webpack",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && npm run deploy:cloudflare:image-runtime && npm run deploy:cloudflare:server && npm run deploy:cloudflare:api && npm run deploy:cloudflare:admin-api && npm run deploy:cloudflare:app",
    "deploy:cloudflare:app": "wrangler deploy",
    "deploy:cloudflare:image-runtime": "wrangler deploy --config wrangler.image-runtime.jsonc",
    "deploy:cloudflare:server": "wrangler deploy --config wrangler.server.jsonc && node scripts/upload-cloudflare-secrets.mjs wrangler.server.jsonc",
    "deploy:cloudflare:api": "node scripts/upload-cloudflare-worker-with-curl.mjs wrangler.api.jsonc && node scripts/upload-cloudflare-secrets.mjs wrangler.api.jsonc",
    "deploy:cloudflare:admin-api": "node scripts/upload-cloudflare-worker-with-curl.mjs wrangler.admin-api.jsonc && node scripts/upload-cloudflare-secrets.mjs wrangler.admin-api.jsonc",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.100.11",
    "@tosspayments/payment-widget-sdk": "^0.12.1",
    "@types/nodemailer": "^8.0.0",
    "arweave": "^1.15.7",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "next": "16.4.6",
    "next-intl": "^4.9.0",
    "nodemailer": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "resend": "^6.17.2",
    "sharp": "^0.35.5",
    "viem": "^2.55.4",
    "wagmi": "^3.7.3",
    "zod": "4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "4.159.0"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.28",
    "eslint-plugin-react-hooks": "7.0.1",
    "glob": "14.0.2",
    "minimatch": "11.0.8",
    "postcss": "^8.5.24",
    "sharp": "$sharp",
    "source-map-js": "1.2.2"
  }
}
