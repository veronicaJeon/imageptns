# ─────────────────────────────────────────────
# Image Partners — 환경변수 템플릿
# 이 파일을 .env.local로 복사 후 값을 채워주세요
# cp .env.example .env.local
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55001
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 마이그레이션 스크립트용 (발급: https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=

# ── 토스페이먼츠 ───────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_
TOSS_SECRET_KEY=test_sk_
# [임시] Toss 유료결제 우회(결제 pass). true면 체크아웃에서 결제 없이 주문 완료 가능.
# Toss live 연동 완료 시 이 값과 관련 코드(/api/checkout/pass 등)를 제거할 것.
NEXT_PUBLIC_PAYMENT_PASS_ENABLED=false

# ── Mistral 이미지 메타데이터 생성 ──────────────────
MISTRAL_API_KEY=
AI_ANALYSIS_HOURLY_LIMIT=60
AI_ANALYSIS_DAILY_LIMIT=300

# ── 의미 기반 이미지 검색 (공급자 선정 전, 기본 OFF) ──
# true 전환은 모델 평가, 국외 이전·보유 정책 승인, 공급자 어댑터 구현 후에만 허용.
SEMANTIC_IMAGE_SEARCH_ENABLED=false
# 승인 이미지 비동기 인덱싱과 사용자 검색 호출은 각각 별도 승인·롤백 가능해야 한다.
SEMANTIC_IMAGE_INDEXING_ENABLED=false
SEMANTIC_IMAGE_QUERY_ENABLED=false
# 제목·태그·설명 키워드가 이 점수 이상이면 Voyage를 호출하지 않음.
KEYWORD_SEARCH_STRONG_THRESHOLD=0.12
# 키워드 fallback 결과도 이 cosine similarity 미만이면 노출하지 않음.
SEMANTIC_SEARCH_MIN_SIMILARITY=0.72
SEMANTIC_EMBEDDING_PROVIDER=
SEMANTIC_EMBEDDING_MODEL=
SEMANTIC_EMBEDDING_MODEL_VERSION=
SEMANTIC_EMBEDDING_DIMENSIONS=
# 로컬/수동 품질평가 전용. 운영 연결 전 공급자 계약·개인정보 게이트 필요.
NVIDIA_API_KEY=
VOYAGE_API_KEY=
VOYAGE_MIN_INTERVAL_MS=21000

# ── 이메일 (Resend) — 시스템 메일 및 contact@ 수신 전달 ──
RESEND_API_KEY=re_
# /api/webhooks/resend-inbound 웹훅 서명 비밀키
RESEND_WEBHOOK_SECRET=whsec_
# 도메인 인증된 공개 발신 주소와 내부 운영 수신함
RESEND_FROM_EMAIL=Image Partners <contact@imagepartners.kr>
OPS_EMAIL=imgptns@gmail.com

# ── 이메일 (Gmail SMTP) — 기존 연결 진단용(앱 발송은 Resend) ──
# Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호 생성 후 입력
GMAIL_SMTP_USER=imgptns@gmail.com
GMAIL_SMTP_PASS=

# ── 앱 ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 온라인 카드결제·정기 구독 공개 플래그. 계좌이체와 무료 사용권에는 영향을 주지 않음.
NEXT_PUBLIC_COMMERCE_ENABLED=false
# Vercel Cron 요청 인증값
CRON_SECRET=

# ── 계좌이체 ──────────────────────────────────
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_ACCOUNT_LABEL=
# 제한 베타에서만 공시 미완료 계좌이체 주문을 예외 허용. 정식 공개 전 제거하거나 false로 변경.
ALLOW_INCOMPLETE_DISCLOSURE_BETA=false

# ── Base USDC Onchain Payments ─────────────────
# Start with Base Sepolia. Switch values for Base mainnet after testnet verification.
NEXT_PUBLIC_ONCHAIN_ENABLED=false
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_IMAGEPARTNERS_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
BASE_RPC_URL=
ONCHAIN_OPERATOR_PRIVATE_KEY=
ONCHAIN_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
ONCHAIN_PLATFORM_FEE_BPS=2000
# MVP fixed quote boundary. Replace with a live quote provider in a later pricing task.
ONCHAIN_USDC_PER_KRW=0.00075
