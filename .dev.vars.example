NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55001
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
OPERATIONS_DAILY_REVIEW_ENABLED=false
APP_RELEASE_SHA=local
APP_RELEASE_REF=local
